{
  "name": "ai-tutor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node --watch --env-file=.env server/index.js",
    "dev:web": "vite",
    "test": "vitest run",
    "build:three": "node scripts/build-three.mjs",
    "check": "node scripts/check-prompts.mjs",
    "build:lessons": "node scripts/generate-lessons.mjs",
    "build:artifact": "node scripts/build-artifact.mjs",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.215",
    "express": "^5.2.1",
    "groq-sdk": "^1.3.0",
    "marked": "^18.0.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
